{
  "name": "stateofsec-ma",
  "main": "./dist/_worker.js/index.js",
  // Must not be newer than the workerd bundled with @astrojs/cloudflare (1.20260114.0)
  "compatibility_date": "2026-01-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
