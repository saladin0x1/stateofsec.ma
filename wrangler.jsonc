{
  "name": "stateofsec-ma",
  "main": "./dist/_worker.js/index.js",
  // Must not be newer than the workerd bundled with @astrojs/cloudflare (1.20260114.0)
  "compatibility_date": "2026-01-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  // Served at these custom domains (zone stateofsec.ma on Cloudflare); dev shares the worker
  // and its Firestore
  "routes": [
    { "pattern": "stateofsec.ma", "custom_domain": true },
    { "pattern": "www.stateofsec.ma", "custom_domain": true },
    { "pattern": "dev.stateofsec.ma", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
