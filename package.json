{
  "name": "state-of-sec-ma",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm validate-survey && astro check && astro build",
    "check": "pnpm validate-survey && astro check",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:ci": "vitest --coverage.enabled true",
    "test:e2e": "playwright test",
    "lint": "eslint --fix \"**/*.{js,jsx,ts,tsx,astro}\"",
    "lint:ci": "eslint \"**/*.{js,jsx,ts,tsx,astro}\"",
    "validate-survey": "tsx ./scripts/validate-survey.ts",
    "verify-smt": "tsx ./scripts/verify/smt.ts",
    "verify-survey": "tsx ./scripts/verify-survey.ts",
    "lock-survey": "tsx ./scripts/lock-survey.ts",
    "prepare": "husky",
    "generate-questions": " tsx ./scripts/generate-questions.ts",
    "generate-questions:ci": " tsx ./scripts/generate-questions.ts",
    "export-results": " tsx --env-file=.env.local ./scripts/export-results.ts",
    "export-results:ci": " tsx  ./scripts/export-results.ts",
    "query-results": "tsx ./scripts/query-results.ts"
  },
  "dependencies": {
    "@astro-community/astro-embed-youtube": "^0.5.3",
    "@astro-utils/context": "^1.1.15",
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/mdx": "^4.3.7",
    "@astrojs/react": "^4.4.0",
    "@astrojs/tailwind": "^6.0.2",
    "@astrolib/seo": "1.0.0-beta.5",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@lion/ui": "^0.7.6",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@xstate/react": "^6.0.0",
    "astro": "5.14.5",
    "firebase": "^10.12.2",
    "jose": "^6.2.12",
    "js-yaml": "^4.1.0",
    "posthog-js": "^1.438.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "xstate": "^5.24.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@eslint-react/eslint-plugin": "^2.3.7",
    "@playwright/test": "1.55.0",
    "@rollup/plugin-yaml": "^4.1.2",
    "@tailwindcss/typography": "^0.5.15",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.18.0",
    "eslint-plugin-astro": "^1.2.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fast-check": "^4.10.2",
    "firebase-admin": "^12.7.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "tsx": "^4.19.1",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix"
    ]
  }
}
