# Copy to .env.local for `pnpm dev` and the export script.
# On Cloudflare, set server secrets with `wrangler secret put <NAME>`.

# Client-side Firebase config (public, embedded in the browser bundle at build time)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Server secrets, from the Firebase service account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Signs the session cookie. At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=

# Cloudflare Turnstile captcha. Required in production; in dev it is enforced only when the
# secret is set. Test keys that always pass: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostHog analytics (EU cloud). Loaded only after a visitor accepts the cookie banner;
# leave the key empty to disable analytics and the banner entirely
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
