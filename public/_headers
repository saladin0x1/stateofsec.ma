# Security headers for the prerendered pages and assets, served without the worker.
# Keep in sync with SECURITY_HEADERS in src/lib/security-headers.ts (worker-rendered responses)
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Searchable early-statistics archive. The one-day cache allows corrected snapshots to replace it.
/reports/morocco-cybersecurity-survey-2026-early-statistics.pdf
  X-Robots-Tag: index, follow
  Content-Disposition: inline; filename="morocco-cybersecurity-survey-2026-early-statistics.pdf"
  Cache-Control: public, max-age=86400
  Link: <https://stateofsec.ma/reports/morocco-cybersecurity-survey-2026-early-statistics.pdf>; rel="canonical"
