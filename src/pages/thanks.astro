---
import BaseLayout from "@/components/layout.astro";
import SocialMediaCard from "@/components/social-media-card.astro";
import { getSessionUserId } from "@/lib/session";

export const prerender = false;

/* Check current session */
if (!(await getSessionUserId(Astro.cookies))) {
  return Astro.redirect("/before-start");
}

const posts = [
  "I just took the State of Sec Morocco survey, a community survey about cybersecurity work in Morocco. It takes about 10 minutes and the results will be released as open data. Add your voice:",
  "Pentester, SOC analyst, GRC, AppSec or student? Help map Morocco's cybersecurity community. I answered the State of Sec Morocco survey, now it's your turn:",
  "How do people get into security in Morocco, what do they work with, and what is missing? The State of Sec Morocco survey wants to find out. Take part:",
  "Open data about Morocco's security community starts with your answers. I took the State of Sec Morocco survey and it only takes a few minutes:"
];
---

<BaseLayout title="Thank you">
  <div class="max-w-screen-xl w-full mx-auto p-6 text-center">
    <h1 class="mt-10 mb-6 text-3xl font-sans font-bold">
      Thank you for taking part
    </h1>

    <div class="mb-8">
      <div class="mb-8 max-w-lg mx-auto text-muted-foreground">
        <p class="mb-4">
          The results are only as good as the number of people who answer. The
          most useful thing you can do now is share the survey with your
          colleagues, your team or your CTF crew.
        </p>
        <p>Here are a few ready-made posts. Pick one and share it.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
        {posts.map(content => <SocialMediaCard content={content} />)}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
function copyContent(button: Element) {
  const content = button.getAttribute("data-content");
  if (!content) {
    console.error("Content not found in dataset");
    return;
  }
  navigator.clipboard
    .writeText(content)
    .then(() => {
      const tooltip = button.querySelector(".tooltip");
      if (tooltip) {
        tooltip.classList.remove("hidden");
        setTimeout(() => {
          tooltip.classList.add("hidden");
        }, 2000);
      }
    })
    .catch((err) => {
      console.error("Failed to copy: ", err);
    });
}

const copyButtons = document.querySelectorAll("[data-id=\"copyButton\"]");

if (copyButtons) {
  copyButtons.forEach((copyButton) => {
    copyButton.addEventListener("click", () => {
      copyContent(copyButton);
    });
  });
}
</script>
