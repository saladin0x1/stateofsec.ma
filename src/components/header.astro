---
import { website } from "@/website";
import HeaderLink from "./header-link.astro";
import Logo from "./logo.astro";
import ThemeToggle from "./theme-toggle.astro";

const navItems = [
  { label: "FAQ", href: "/faq" },
  { label: "GitHub", href: website.repoGithub, external: true }
];

const currentPath = Astro.url.pathname;
---

<header
  class="z-[99] relative bg-transparent max-w-screen-xl w-full px-4 py-4 text-foreground md:mx-auto border-b border-border"
>
  <div class="flex justify-between items-center">
    <a href="/" class="z-10" aria-label={`${website.name} home`}>
      <div
        class="flex cursor-pointer items-center whitespace-nowrap text-base sm:text-lg md:text-2xl"
      >
        <Logo />
      </div>
    </a>

    <div class="md:hidden">
      <button
        type="button"
        id="nav-toggle"
        class="relative z-20 cursor-pointer text-foreground"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">Toggle navigation</span>
        <svg
          data-icon="open"
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
        <svg
          data-icon="close"
          xmlns="http://www.w3.org/2000/svg"
          class="hidden h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>

      <nav
        id="mobile-nav"
        aria-label="Header Navigation"
        class="fixed inset-0 z-10 flex translate-x-full transform items-center justify-center bg-background transition-transform duration-300 ease-in-out"
      >
        <ul class="flex flex-col items-center space-y-6 text-lg">
          {
            navItems.map(item => (
              <li>
                <HeaderLink
                  label={item.label}
                  href={item.href}
                  external={item.external}
                  isActive={currentPath === item.href}
                />
              </li>
            ))
          }
          <li>
            <ThemeToggle />
          </li>
        </ul>
      </nav>
    </div>

    <nav
      aria-label="Header Navigation"
      class="hidden md:flex md:flex-row md:items-center md:space-x-6"
    >
      <ul class="flex flex-row space-x-6">
        {
          navItems.map(item => (
            <li>
              <HeaderLink
                label={item.label}
                href={item.href}
                external={item.external}
                isActive={currentPath === item.href}
              />
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>

<script>
const toggle = document.getElementById("nav-toggle");
const nav = document.getElementById("mobile-nav");

if (toggle && nav) {
  const btn = toggle;
  const panel = nav;
  const iconOpen = btn.querySelector("[data-icon=\"open\"]");
  const iconClose = btn.querySelector("[data-icon=\"close\"]");

  const setOpen = (open: boolean) => {
    btn.setAttribute("aria-expanded", String(open));
    panel.classList.toggle("translate-x-0", open);
    panel.classList.toggle("translate-x-full", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    // Stop the page scrolling behind the full-screen menu
    document.body.classList.toggle("overflow-hidden", open);
  };

  btn.addEventListener("click", () => {
    setOpen(btn.getAttribute("aria-expanded") !== "true");
  });

  // Close after navigating or on Escape
  panel.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape")
      setOpen(false);
  });
}
</script>
