---
import { faqs } from "@/lib/faq";
import { website } from "@/website";
import FaqItem from "./faq-item.astro";
---

<section class="max-w-4xl mx-auto px-4 py-24">
  <h2 class="text-2xl md:text-3xl font-sans font-bold mb-12 text-center">
    Frequently Asked Questions
  </h2>
  <p class="text-center max-w-2xl mx-auto">
    Answers to common questions about the {website.name} survey. Something
    missing? <a
      href={`${website.repoGithub}/issues`}
      target="_blank"
      class="text-primary hover:opacity-90"
      rel="noopener noreferrer"
             >Open an issue</a
    >.
  </p>
  <div class="space-y-4 pt-8">
    {
      faqs.map((faq, index) => (
        <FaqItem label={faq.question} checked={index === 0}>
          <Fragment set:html={faq.answer} />
        </FaqItem>
      ))
    }
  </div>
</section>
