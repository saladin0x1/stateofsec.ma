---
import { website } from "@/website";
import Logo from "./logo.astro";

const projectLinks = [
  { label: "GitHub repository", href: website.repoGithub },
  { label: "Instagram", href: website.instagram },
  { label: "Report an issue", href: `${website.repoGithub}/issues` },
  { label: "FAQ", href: "/faq" }
];

// One string so template whitespace cannot end up inside the link text
const authorLinks = website.authors
  .map(author => `<a href="${author.url}" target="_blank" rel="noopener noreferrer" class="hover:text-foreground">${author.handle}</a>`)
  .join(" &amp; ");
---

<footer class="mt-24 border-t border-border bg-background">
  <div
    class="mx-auto grid max-w-screen-xl gap-y-8 gap-x-12 px-4 py-12 sm:px-6 md:grid-cols-2 lg:grid-cols-4 xl:px-8"
  >
    <div class="md:col-span-2 flex flex-col justify-between">
      <div>
        <div class="mb-6 flex h-10 items-center text-xl">
          <Logo />
        </div>
        <div class="text-muted-foreground max-w-sm mb-6">
          {website.description}
        </div>
      </div>
    </div>

    <div>
      <h3
        class="mb-4 text-sm font-semibold uppercase tracking-wider text-foreground"
      >
        Project
      </h3>
      <ul class="space-y-2 font-mono">
        {
          projectLinks.map(link => (
            <li>
              <a
                class="inline-block cursor-pointer transition-all duration-200 px-2 py-1 rounded -ml-2 text-muted-foreground hover:text-primary hover:bg-primary/5"
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel="noopener noreferrer"
              >
                <span>[{link.label}]</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3
        class="mb-4 text-sm font-semibold uppercase tracking-wider text-foreground"
      >
        Credits
      </h3>
      <button
        type="button"
        popovertarget="credits-popover"
        class="inline-block cursor-pointer transition-all duration-200 px-2 py-1 rounded -ml-2 font-mono text-muted-foreground hover:text-primary hover:bg-primary/5"
      >
        [GeeksBlaBla]
      </button>
      <div
        id="credits-popover"
        popover="auto"
        class="relative m-auto max-w-sm rounded-lg border border-border bg-background p-5 text-left text-sm text-muted-foreground shadow-xl"
      >
        <button
          type="button"
          popovertarget="credits-popover"
          popovertargetaction="hide"
          class="absolute right-3 top-3 text-muted-foreground hover:text-foreground"
          aria-label="Close"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"
            ></path>
          </svg>
        </button>
        <p class="mb-3 pr-6 font-semibold text-foreground">Credits</p>
        <p class="mb-4">
          State of Sec Morocco is based on State of Dev, the open-source annual
          survey of Morocco's developer community built by <span
            class="text-foreground"
                                                           >GeeksBlaBla</span
          >. Big thanks to GeeksBlaBla and its contributors for the original
          project.
        </p>
        <a
          href={website.basedOn.byUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-primary hover:underline"
        >
          Visit GeeksBlaBla
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-border">
    <div
      class="mx-auto flex max-w-screen-xl flex-col gap-y-4 px-4 py-6 text-center text-sm text-muted-foreground sm:px-6 lg:flex-row lg:justify-between lg:text-left xl:px-8"
    >
      <p>
        © {new Date().getFullYear()} stateofsec.ma · <Fragment
          set:html={authorLinks}
                                                     />
      </p>
      <button
        type="button"
        data-consent-settings
        class="hover:text-foreground"
      >
        [Cookie settings]
      </button>
    </div>
  </div>
</footer>
